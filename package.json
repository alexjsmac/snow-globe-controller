{
  "name": "snow-globe-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=\"\\.test\\.(ts|tsx)$\"",
    "test:integration": "jest --testPathPattern=\"\\.integration\\.test\\.(ts|tsx)$\"",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "validate": "npm run type-check && npm run lint && npm run test",
    "export": "next build",
    "reset-queue": "node scripts/reset-queue.js",
    "admin-reset": "node scripts/admin-reset.js",
    "analyze-trends": "node scripts/analyze-trends.js"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "firebase": "^12.6.0",
    "next": "^16.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.29",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^29.2.1",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5"
  }
}