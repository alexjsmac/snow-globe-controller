{
  "rules": {
    ".read": false,
    ".write": false,
    "queue": {
      ".read": true,
      ".write": true,
      "activeUser": {
        ".validate": "newData.val() === 'none' || newData.hasChildren(['sessionId', 'startTime', 'endTime'])"
      },
      "waitingUsers": {
        "$sessionId": {
          ".validate": "newData.hasChildren(['sessionId', 'joinedAt']) && $sessionId == newData.child('sessionId').val()"
        }
      },
      "queueLength": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },
    "themeValues": {
      ".read": true,
      ".write": true,
      "current": {
        ".validate": "newData.hasChild('row1') && newData.hasChild('row2') && newData.hasChild('row3') && newData.hasChild('sessionId') && newData.hasChild('timestamp')",
        "row1": {
          ".validate": "newData.isString()"
        },
        "row2": {
          ".validate": "newData.isString()"
        },
        "row3": {
          ".validate": "newData.isString()"
        },
        "sessionId": {
          ".validate": "newData.isString()"
        },
        "timestamp": {
          ".validate": "newData.val() !== null"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "motionValues": {
      ".read": true,
      ".write": true,
      "current": {
        ".validate": "newData.hasChild('x') && newData.hasChild('y') && newData.hasChild('z') && newData.hasChild('sessionId') && newData.hasChild('timestamp')",
        "x": {
          ".validate": "newData.isNumber()"
        },
        "y": {
          ".validate": "newData.isNumber()"
        },
        "z": {
          ".validate": "newData.isNumber()"
        },
        "sessionId": {
          ".validate": "newData.isString()"
        },
        "timestamp": {
          ".validate": "newData.val() !== null"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sessions": {
      ".read": "auth != null",
      ".write": true,
      "$sessionId": {
        ".validate": "newData.hasChildren(['sessionId', 'startTime', 'endTime', 'duration']) && $sessionId == newData.child('sessionId').val()"
      }
    },
    "systemState": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['lastUpdated'])"
    }
  }
}
